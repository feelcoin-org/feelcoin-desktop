{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Feelcoin Desktop",
  "version": "0.2.0-beta.1",
  "identifier": "org.feelcoin.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Feelcoin Desktop",
        "width": 1180,
        "height": 760,
        "minWidth": 980,
        "minHeight": 660,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Finance",
    "shortDescription": "Official Feelcoin desktop wallet",
    "longDescription": "Self-contained Feelcoin desktop wallet with local daemon and wallet RPC support.",
    "resources": [
      "resources/bin/*",
      "resources/lib/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "publisher": "Feelcoin",
    "homepage": "https://feelcoin.org",
    "license": "BSD-3-Clause",
    "linux": {
      "deb": {
        "files": {
          "/usr/share/metainfo/org.feelcoin.desktop.metainfo.xml": "linux/org.feelcoin.desktop.metainfo.xml"
        }
      }
    }
  }
}
